# ---------------------------------------------------------------
# Copia este archivo a .env y completa los valores.
# ---------------------------------------------------------------

# Puerto del servidor (API + Colyseus + estaticos en produccion)
PORT=2567

# Origen permitido para CORS en desarrollo local (Vite).
# En modo tunel no hace falta: todo sale del mismo origen.
DEV_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------
# ACCESO DE PROFESOR
# ---------------------------------------------------------------
# Solo quien tenga este codigo puede crear salones. Si lo dejas
# vacio, el servidor genera uno al arrancar y lo imprime en la
# consola -distinto en cada reinicio-. Fijalo aqui para que no
# cambie durante el semestre.
#
# En la fase 2 esto lo reemplaza la autenticacion de profesor
# contra Supabase.
TEACHER_CODE=

# ---------------------------------------------------------------
# VOZ - LiveKit
# ---------------------------------------------------------------
# El tunel de Cloudflare NO transporta el UDP de WebRTC, asi que
# el audio va por fuera. Para la fase 1 usamos LiveKit Cloud
# (plan gratuito): https://cloud.livekit.io -> crear proyecto.
#
# Si estos tres valores quedan vacios, la app arranca igual pero
# sin voz, y lo dice en pantalla. Todo lo demas funciona.
#
# Para pasar a LiveKit auto-hospedado mas adelante solo cambia
# LIVEKIT_URL (por ejemplo wss://livekit.tudominio.co).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------
# Cliente (Vite)
# ---------------------------------------------------------------
# Normalmente NO hace falta tocar nada aqui. El cliente deduce a
# donde hablar:
#   - compilado o detras del tunel -> el mismo origen de la pagina
#   - en desarrollo -> el hostname actual + VITE_SERVER_PORT
#
# Dejarlo deducir es lo que permite abrir la app desde el celular
# con http://192.168.x.x:5173 sin cambiar nada: si aqui pusieras
# "localhost", el celular buscaria la API en si mismo.
#
# Solo define VITE_API_URL si el servidor vive en otra maquina.
# VITE_API_URL=https://api.tudominio.co
VITE_SERVER_PORT=2567
